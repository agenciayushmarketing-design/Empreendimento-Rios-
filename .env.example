# Copie este arquivo para .env.local e preencha com os valores do Supabase.
# O projeto usa o SISTEMA NOVO de chaves do Supabase: sb_publishable_* (publica) e sb_secret_* (secreta).

# --- Publicas (podem ir para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secretas (NUNCA suba para o GitHub) ---
SUPABASE_SECRET_KEY=

# --- Banco ---
# DATABASE_URL = pooler de transacao, porta 6543 (uso em runtime).
# DIRECT_URL   = conexao direta, porta 5432 (uso em migracoes drizzle-kit).
DATABASE_URL=
DIRECT_URL=
