# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase.
# Sistema NOVO de chaves: sb_publishable_* (publica) e sb_secret_* (secreta).

# --- Publicas (vao para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secreta (NUNCA suba para o GitHub). Opcional: so para rotinas administrativas server-side. ---
# SUPABASE_SECRET_KEY=
